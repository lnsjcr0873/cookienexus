{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "parsableStyle": true
  },
  "ignore": {
    "customPatterns": [
      "**/node_modules/**",
      "**/dist/**",
      "**/.git/**",
      "**/__pycache__/**",
      "*.tmp"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
